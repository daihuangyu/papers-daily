    {
      "tex": "\\begin{aligned}\n&\\max_{q\\in\\Delta(S)} (1-\\kappa)\\mathbb E_{v\\sim q}d(v)-\\kappa D_{\\rm KL}(q\\|b),\\\\\n&\\text{subject to}\\quad D_{\\rm KL}(q\\|b)\\le\\epsilon,\\qquad\n\\widetilde q_\\beta(v)=\\frac{b(v)\\exp(\\beta d(v))}{\\sum_{u\\in S}b(u)\\exp(\\beta d(u))},\n\\quad\\beta=\\frac{1-\\kappa}{\\kappa+\\lambda}.\n\\end{aligned}",
      "display": true,
      "width_pt": 398.60760000000005,
