      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\nD_{\\rm KL}(p_\\theta\\|p_T)&=\\sum_a p_\\theta(a\\mid s)\n  [\\log p_\\theta(a\\mid s)-\\log p_T(a\\mid s)],\\\\\nA_j&=\\mathrm{stopgrad}[\\log p_T(a_j\\mid s_j)-\\log p_\\theta(a_j\\mid s_j)],\\\\\ng_{\\rm loss}&=-\\mathbb E_{y\\sim q_c}\\!\\left[\\sum_j A_j\n      \\nabla_\\theta\\log p_\\theta(a_j\\mid s_j)\\right].\n\\end{aligned}",
      "display": true,
      "width_pt": 287.60040000000004,
      "height_pt": 81.954,
