      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\n\\ell(\\theta;h_t,y)&=\\frac1L\\sum_{j=1}^L D_{\\rm KL}(p_{\\theta,j}\\|p_{T,j}),\\\\\nC(h_t,y)&=\\frac1L\\sum_{j=1}^L\\max_{v\\in V}p_{T,j}(v),\\\\\ng_\\gamma(h_t,y;B)&=\\mathbf{1}\\!\\left[C(h_t,y)\\ge \\mathrm{Quantile}_\\gamma\\{C_b:b\\in B\\}\\right].\n\\end{aligned}",
      "display": true,
      "width_pt": 265.28040000000004,
      "height_pt": 95.53079999999999,
      "rendered_svg_sha256": "af7e31b4c2364bbaf0c57a4f3df16b589a280c5136f5702f669f2a3dfbd166b5",
      "inline_png_sha256": null
