      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\n\\Delta_T(v)&=\\log\\frac{q^+(v)}{t_{\\rm ref}(v)},&\n\\Delta_S(v)&=\\log\\frac{q^+(v)}{\\pi_0(v)},\\\\\n\\bar\\Delta_j(v)&=\\Delta_j(v)-\\mathbb E_{u\\sim b}\\Delta_j(u),&\n\\sigma_j^2&=\\mathbb E_{u\\sim b}\\big[\\bar\\Delta_j(u)^2\\big],\\quad j\\in\\{T,S\\}.\n\\end{aligned}",
      "display": true,
      "width_pt": 366.0216,
      "height_pt": 49.242,
