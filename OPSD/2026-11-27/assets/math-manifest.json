    {
      "tex": "\\begin{aligned}\n\\ell_\\theta&=D_{\\rm KL}(\\widetilde q_\\beta\\|\\pi_\\theta)\\\\\n&=D_{\\rm KL}(\\widetilde q_\\beta\\|\\pi_{\\theta,S})-\\log\\pi_\\theta(S),\\qquad\n\\frac{\\partial\\ell_\\theta}{\\partial z_v}=\\pi_\\theta(v)-\\widetilde q_\\beta(v).\n\\end{aligned}",
      "display": true,
      "width_pt": 295.236,
