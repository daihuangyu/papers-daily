    {
      "tex": "\\begin{aligned}\nK_j&=D_{\\mathrm{KL}}(p_j\\Vert q_j),\\\\\n\\partial_{z_{j,v}}L_{\\mathrm{RKL}}\n &=p_j(v)\\left(\\log\\frac{p_j(v)}{q_j(v)}-K_j\\right),\\\\\n\\partial_{z_{j,v}}L_{\\mathrm{FKL}}&=p_j(v)-q_j(v).\n\\end{aligned}",
