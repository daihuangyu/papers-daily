    {
      "tex": "\\begin{aligned}\n\\frac{\\partial L_{\\mathrm{seq}}}{\\partial z_{c,v}}\n &=w_c p_c(v)\\left[\n \\log\\frac{p_c(v)}{q_c(v)}+R(cv)-R(c)\\right],\\\\\n\\tilde q_c(v)&=\n \\frac{q_c(v)e^{-R(cv)}}{\\sum_u q_c(u)e^{-R(cu)}} .\n\\end{aligned}",
