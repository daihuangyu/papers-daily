      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\nD_f(q_c\\Vert p_c)&=\\sum_v p_c(v) f\\left(\\frac{q_c(v)}{p_c(v)}\\right),\\\\\na_f(u)&=e^u f'(e^u)-f(e^u),\\qquad\nu_v=\\log\\frac{q_c(v)}{p_c(v)},\\\\\ng_v&=-w_c p_c(v)\\left[a_f(u_v)-\\mathbb E_{j\\sim p_c}a_f(u_j)\\right].\n\\end{aligned}",
      "display": true,
