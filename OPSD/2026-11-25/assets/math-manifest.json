    {
      "tex": "\\begin{aligned}\n\\frac{\\partial q_v}{\\partial z_j}&=q_v(\\mathbf1[v=j]-q_j),\\\\\n\\frac{\\partial\\ell}{\\partial z_j}\n &=q_j\\left(\\sum_v q_v r_v-r_j\\right).\n\\end{aligned}",
