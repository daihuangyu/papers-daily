      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\nA_t&=\\begin{cases}\n\\log\\pi_T(y_t\\mid\\tilde x,\\varnothing,a_{\\lt t})\n -\\log\\pi_S(y_t\\mid x,y_{\\lt t}),&t\\in\\mathcal A,\\\\\n0,&t\\in\\mathcal Z ,\n\\end{cases}\\\\\n\\widehat{\\ell}_t&=-\\mathrm{stopgrad}(A_t)\\,\n                      \\log\\pi_S(y_t\\mid x,y_{\\lt t}).\n\\end{aligned}",
      "display": true,
      "width_pt": 293.202,
