    },
    {
      "tex": "\\begin{aligned}\ns_\\theta(y,x)&=\\log\\pi_\\theta(y\\mid x)-\\log\\pi_{\\rm ref}(y\\mid x),\\\\\nz&=\\beta\\big[s_\\theta(y^+,x)-s_\\theta(y^-,x)\\big],\\\\\n\\mathcal L_{\\rm DPO}^{\\rm demo}&=-\\log\\sigma(z).\n\\end{aligned}",
      "display": true,
