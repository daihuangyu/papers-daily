    {
      "tex": "\\begin{aligned}\nu_k &= p^T_k-p^S_k,\\qquad v_k=p^S_k-p^M_k,\\\\\n\\langle u,v\\rangle_{p^S}\n&=\\sum_{k\\in\\mathcal K}\\frac{u_kv_k}{\\max(p^S_k,\\epsilon)},\\\\\nw &= \\max\\!\\left(0,\\frac{\\langle u,v\\rangle_{p^S}}\n{\\|u\\|_{p^S}\\|v\\|_{p^S}}\\right).\n\\end{aligned}",
