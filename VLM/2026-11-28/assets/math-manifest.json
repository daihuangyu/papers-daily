    {
      "tex": "\\begin{aligned}\n\\delta_{in}&={\\rm sg}\\!\\left([\\ell^{T,o}_{in}-\\ell^{T,m}_{in}]_+\\right),\\\\\ng_{in}&={\\rm clip}\\!\\left(\\ell^S_{in}-{\\rm sg}(\\ell^M_{in}),0,c\\right),\\\\\n\\phi(g)&=\\min\\{K,e^{-g}-1+g\\},\\\\\n\\mathcal L_{\\rm vis}\n&=-\\frac1R\\sum_{i=1}^R\n\\frac{\\sum_{n\\in A_i}\\delta_{in}\\phi(g_{in})}{\\max(1,|A_i|)},\\\\\n\\mathcal L &= \\mathcal L_{\\rm dir}+\\lambda\\mathcal L_{\\rm vis}.\n\\end{aligned}",
      "display": true,
      "width_pt": 173.00879999999998,
      "height_pt": 111.76920000000001,
      "rendered_svg_sha256": "1979009cfe3915641fa6f937065ac2157c7f0eb29a1b586ae48463f8accaa6c3",
      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\n\\mathcal L_{\\rm act}\n&=-\\sum_{k=0}^{K-1}\n\\log\\pi_\\theta(a_{t+k}\\mid a_{t:t+k-1},c_t),\\\\\n\\mathcal L_{\\rm prog}\n&=-\\sum_{m=1}^{M}\\log\\pi_\\theta(g_m\\mid g_{\\lt m},c_t),\\\\\n\\mathcal L_{\\rm stage\\,2}\n&=\\mathcal L_{\\rm act}+\\lambda\\mathcal L_{\\rm prog}.\n\\end{aligned}",
      "display": true,
      "width_pt": 207.68880000000001,
      "height_pt": 91.4784,
      "rendered_svg_sha256": "5035b19512c8d42d44b4c6fc0676bc1759b8a7fed966e132dcc3aff83ff3e96e",
      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\n\\mathcal L_{\\rm box}&=-\\sum_{i=1}^N y_i\\log p_i,\\\\\n\\mathcal L_{\\rm distill}\n&=\\frac1T\\sum_{t=1}^T\\left[\n\\tfrac12\\mathrm{KL}(p^F_t\\Vert m_t)+\n\\tfrac12\\mathrm{KL}(p^C_t\\Vert m_t)\\right].\n\\end{aligned}",
      "display": true,
      "width_pt": 248.5932,
      "height_pt": 75.042,
      "rendered_svg_sha256": "3054ffa55171d3afcf5105103ba129c9cd4a1d32664f0bb52d67c2af0ca851d1",
      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\nh_{it}&=\\tanh((\\sigma_{it}-\\bar\\sigma_i)/\\tau),\\\\\nu_{it}&=(h_{it}-\\bar h_i)/2,\\\\\nw_{it}&=1+\\beta s_i u_{it},\\qquad A_{it}^{\\rm CICA}=w_{it}A_i.\n\\end{aligned}",
      "display": true,
      "width_pt": 191.2968,
      "height_pt": 47.65560000000001,
      "rendered_svg_sha256": "dda703e6e22a00050acd8f970d37f37986a0f1391d7133497a10c02d9c059638",
      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\nj^\\star_{it}\n&=\\arg\\max_j\\log\\pi_\\theta(y_{it}\\mid x^{(j)},y_{i,\\lt t}),\\\\\n\\sigma_{it}\n&=\\log\\pi_\\theta(y_{it}\\mid x,y_{i,\\lt t})\n-\\max_j\\log\\pi_\\theta(y_{it}\\mid x^{(j)},y_{i,\\lt t}).\n\\end{aligned}",
      "display": true,
      "width_pt": 274.04040000000003,
      "height_pt": 47.592,
      "rendered_svg_sha256": "43ba4b80439eb47e7ae71c003db7d0a40d2bad15c98ba7776e59282744bd26df",
      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\nm_n&=(p^T_n+p^S_n)/2,\\\\\n\\mathrm{JS}(p^T_n,p^S_n)\n&=\\tfrac12\\mathrm{KL}(p^T_n\\Vert m_n)+\n\\tfrac12\\mathrm{KL}(p^S_n\\Vert m_n),\\\\\n\\mathcal L_{\\rm dir}\n&=\\mathbb E_y\\!\\left[\n\\frac{1}{|N(y)|}\\sum_{n\\in N(y)}\n{\\rm sg}(w_n)\\mathrm{JS}({\\rm sg}(p^T_n),p^S_n)\\right].\n\\end{aligned}",
      "display": true,
      "width_pt": 280.22159999999997,
      "height_pt": 76.452,
      "rendered_svg_sha256": "1ee9209be9e85d7b2c4f0d97ea56bfd38d5af9df147f4b10518dfdb90ae417f1",
      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\np_i &= \\frac{\\exp(r_i)}{\\sum_{j=1}^{N}\\exp(r_j)},\\\\\nd_i&=\\min_{j\\in S}\n\\left(1-\\frac{h_i^\\top h_j}{\\|h_i\\|\\|h_j\\|}\\right),\\\\\ni^\\star &=\\arg\\max_{i\\notin S} d_i(Np_i)^{\\gamma},\n\\qquad \\gamma=0.25.\n\\end{aligned}",
      "display": true,
      "width_pt": 191.4468,
      "height_pt": 97.21920000000001,
      "rendered_svg_sha256": "6b324cfe733f013dfdd2ef3171e5c6dca7dbd0632f6ecf461c1130976bb5f235",
      "inline_png_sha256": null
    },
    {
      "tex": "\\begin{aligned}\np_t(k)&=\\pi_T(k\\mid x_T,y_{\\lt t}),\\quad\nq_t(k)=\\pi_\\theta(k\\mid x_S,y_{\\lt t}),\\\\\n\\mathcal L_{\\rm KD}^{\\rm demo}\n&=\\mathbb E_{y\\sim\\pi_\\theta}\\left[\n\\frac1T\\sum_{t=1}^T\\sum_k p_t(k)\\log\\frac{p_t(k)}{q_t(k)}\n\\right].\n\\end{aligned}",
      "display": true,
      "width_pt": 254.4756,
